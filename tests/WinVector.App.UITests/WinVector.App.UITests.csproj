<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de la interfaz nativa con FlaUI (UI Automation). Necesitan Windows y WinVector
    instalado: se indica con la variable WINVECTOR_AUMID (identificador del modelo de usuario de
    la aplicación, por ejemplo WinVector_xxxxxxxxxxxxx!App). Sin ella, las pruebas no se ejecutan.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- El mismo SVG de ejemplo que usa la aplicación, para las pruebas de abrir y guardar. -->
    <Content Include="..\..\src\engine\src\sample.svg" Link="Ejemplo.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="MSTest" />
    <!-- Para encontrar el proceso de renderizado del lienzo y simular que falla (#24). -->
    <PackageReference Include="System.Management" />
  </ItemGroup>

</Project>
