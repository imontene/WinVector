<Project>

  <!-- Configuración común a todos los proyectos .NET del repositorio. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Authors>The WinVector Authors</Authors>
    <Company>The WinVector Authors</Company>
    <Product>WinVector</Product>
    <Copyright>Copyright 2026 The WinVector Authors</Copyright>
    <NeutralLanguage>es-ES</NeutralLanguage>
  </PropertyGroup>

</Project>
