<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinVector.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:WinVector.App.Shell"
    xmlns:controls="using:WinVector.App.Controls"
    xmlns:shell="using:WinVector.Core.Shell"
    Title="WinVector">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Distribución "Estudio clásico" (opción A del plan):
        fila 0, pestañas de documento en la barra de título;
        fila 1, menú y barra de comandos;
        fila 2, herramientas, lienzo y propiedades;
        fila 3, barra de estado.
    -->
    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.Resources>
            <Style x:Key="ToolButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="PaneBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Fila 0: pestañas en la barra de título -->
        <TabView
            x:Name="DocumentTabs"
            Grid.Row="0"
            VerticalAlignment="Top"
            AddTabButtonClick="OnAddTabButtonClick"
            CanDragTabs="False"
            CanReorderTabs="False"
            IsAddTabButtonVisible="True"
            SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=OneWay}"
            SelectionChanged="OnDocumentTabsSelectionChanged"
            TabCloseRequested="OnTabCloseRequested"
            TabItemsSource="{x:Bind ViewModel.Documents}">
            <TabView.TabStripHeader>
                <StackPanel
                    x:Name="TitleBarHeader"
                    Padding="12,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Image
                        Width="16"
                        Height="16"
                        Source="ms-appx:///Assets/Square44x44Logo.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="WinVector" />
                </StackPanel>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="TitleBarDragRegion" Background="Transparent" />
            </TabView.TabStripFooter>
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="shell:DocumentTabViewModel">
                    <TabViewItem
                        AutomationProperties.Name="{x:Bind Header, Mode=OneWay}"
                        Header="{x:Bind Header, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind FilePath, Mode=OneWay}">
                        <TabViewItem.IconSource>
                            <SymbolIconSource Symbol="Document" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Fila 1: menú y barra de comandos -->
        <Border
            Grid.Row="1"
            BorderThickness="0,1,0,1"
            Style="{StaticResource PaneBorderStyle}">
            <Grid Padding="4,0,8,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <MenuBar Grid.Column="0">
                    <MenuBarItem x:Uid="MenuFile">
                        <MenuFlyoutItem x:Uid="MenuFileNew" Command="{x:Bind ViewModel.NewDocumentCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="MenuFileNewWithSize" Command="{x:Bind ViewModel.NewDocumentWithSizeCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="MenuFileOpen" Command="{x:Bind ViewModel.OpenCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem x:Name="RecentFilesMenu" x:Uid="MenuFileRecent" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuFileSave" Command="{x:Bind ViewModel.SaveCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="MenuFileSaveAs" Command="{x:Bind ViewModel.SaveAsCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuFileCloseTab" Click="OnCloseTabClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="W" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="MenuFileExit" Click="OnExitClick" />
                    </MenuBarItem>

                    <MenuBarItem x:Name="EditMenu" x:Uid="MenuEdit">
                        <!-- Los atajos de deshacer y rehacer solo están aquí: el motor no los atiende, para no deshacer dos veces. -->
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="MenuEditUndo"
                            Command="{x:Bind ViewModel.UndoCommand}"
                            Text="{x:Bind ViewModel.UndoLabel, Mode=OneWay}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Z" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="MenuEditRedo"
                            Command="{x:Bind ViewModel.RedoCommand}"
                            Text="{x:Bind ViewModel.RedoLabel, Mode=OneWay}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Y" Modifiers="Control" />
                                <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <!-- Sin aceleradores: Ctrl+X, Ctrl+C, Ctrl+V y Supr son de los cuadros de texto. Con el lienzo enfocado, el motor los atiende o los reenvía. -->
                        <MenuFlyoutItem
                            x:Uid="MenuEditCut"
                            AutomationProperties.AutomationId="MenuEditCut"
                            Command="{x:Bind ViewModel.CutCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+X" />
                        <MenuFlyoutItem
                            x:Uid="MenuEditCopy"
                            AutomationProperties.AutomationId="MenuEditCopy"
                            Command="{x:Bind ViewModel.CopyCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+C" />
                        <MenuFlyoutItem
                            x:Uid="MenuEditPaste"
                            AutomationProperties.AutomationId="MenuEditPaste"
                            Command="{x:Bind ViewModel.PasteCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+V" />
                        <MenuFlyoutItem
                            x:Uid="MenuEditDuplicate"
                            AutomationProperties.AutomationId="MenuEditDuplicate"
                            Command="{x:Bind ViewModel.DuplicateCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="D" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="MenuEditDelete"
                            AutomationProperties.AutomationId="MenuEditDelete"
                            Command="{x:Bind ViewModel.DeleteCommand}" />
                        <MenuFlyoutSeparator />
                        <!-- Sin acelerador: Ctrl+A lo atiende el lienzo, y así no se quita a los cuadros de texto. -->
                        <MenuFlyoutItem
                            x:Uid="MenuEditSelectAll"
                            AutomationProperties.AutomationId="MenuEditSelectAll"
                            Command="{x:Bind ViewModel.SelectAllCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+A" />
                    </MenuBarItem>

                    <MenuBarItem x:Name="ObjectMenu" x:Uid="MenuObject">
                        <!-- Con el lienzo enfocado, estos atajos los atiende el motor (ver src/engine/src/tools/shortcuts.ts). -->
                        <MenuFlyoutItem
                            x:Uid="MenuObjectGroup"
                            AutomationProperties.AutomationId="MenuObjectGroup"
                            Command="{x:Bind ViewModel.GroupCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="G" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="MenuObjectUngroup"
                            AutomationProperties.AutomationId="MenuObjectUngroup"
                            Command="{x:Bind ViewModel.UngroupCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="G" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="MenuObjectBringToFront"
                            AutomationProperties.AutomationId="MenuObjectBringToFront"
                            Command="{x:Bind ViewModel.BringToFrontCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="PageUp" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="MenuObjectBringForward"
                            AutomationProperties.AutomationId="MenuObjectBringForward"
                            Command="{x:Bind ViewModel.BringForwardCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="PageUp" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="MenuObjectSendBackward"
                            AutomationProperties.AutomationId="MenuObjectSendBackward"
                            Command="{x:Bind ViewModel.SendBackwardCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="PageDown" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="MenuObjectSendToBack"
                            AutomationProperties.AutomationId="MenuObjectSendToBack"
                            Command="{x:Bind ViewModel.SendToBackCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="PageDown" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>

                    <MenuBarItem x:Uid="MenuPath">
                        <MenuFlyoutItem x:Uid="MenuPathObjectToPath" IsEnabled="False" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="MenuText">
                        <MenuFlyoutItem x:Uid="MenuTextFont" IsEnabled="False" />
                    </MenuBarItem>

                    <MenuBarItem x:Name="ViewMenu" x:Uid="MenuView">
                        <!-- Los atajos de zoom se añaden en el código: Ctrl++ y Ctrl+- no tienen nombre en VirtualKey. -->
                        <MenuFlyoutItem
                            x:Name="ZoomInMenuItem"
                            x:Uid="MenuViewZoomIn"
                            AutomationProperties.AutomationId="MenuViewZoomIn"
                            Command="{x:Bind ViewModel.ZoomInCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl++" />
                        <MenuFlyoutItem
                            x:Name="ZoomOutMenuItem"
                            x:Uid="MenuViewZoomOut"
                            AutomationProperties.AutomationId="MenuViewZoomOut"
                            Command="{x:Bind ViewModel.ZoomOutCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+-" />
                        <MenuFlyoutItem
                            x:Uid="MenuViewFit"
                            AutomationProperties.AutomationId="MenuViewFit"
                            Command="{x:Bind ViewModel.ZoomFitCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number0" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="MenuViewActualSize"
                            AutomationProperties.AutomationId="MenuViewActualSize"
                            Command="{x:Bind ViewModel.ZoomActualCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number1" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem
                            x:Uid="MenuViewRulers"
                            AutomationProperties.AutomationId="MenuViewRulers"
                            IsChecked="{x:Bind ViewModel.ShowRulers, Mode=TwoWay}">
                            <ToggleMenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="R" Modifiers="Control" />
                            </ToggleMenuFlyoutItem.KeyboardAccelerators>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            x:Uid="MenuViewGrid"
                            AutomationProperties.AutomationId="MenuViewGrid"
                            IsChecked="{x:Bind ViewModel.ShowGrid, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem
                            x:Uid="MenuViewSnapToGrid"
                            AutomationProperties.AutomationId="MenuViewSnapToGrid"
                            IsChecked="{x:Bind ViewModel.SnapToGrid, Mode=TwoWay}" />
                    </MenuBarItem>

                    <MenuBarItem x:Name="HelpMenu" x:Uid="MenuHelp">
                        <MenuFlyoutItem
                            x:Name="OpenSampleMenuItem"
                            x:Uid="MenuHelpOpenSample"
                            Click="OnOpenSampleClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuHelpAbout" Click="OnAboutClick" />
                    </MenuBarItem>
                </MenuBar>

                <CommandBar
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    OverflowButtonVisibility="Auto">
                    <AppBarButton
                        x:Uid="CommandUndo"
                        AutomationProperties.AutomationId="UndoButton"
                        Command="{x:Bind ViewModel.UndoCommand}"
                        Icon="Undo"
                        ToolTipService.ToolTip="{x:Bind ViewModel.UndoLabel, Mode=OneWay}" />
                    <AppBarButton
                        x:Uid="CommandRedo"
                        AutomationProperties.AutomationId="RedoButton"
                        Command="{x:Bind ViewModel.RedoCommand}"
                        Icon="Redo"
                        ToolTipService.ToolTip="{x:Bind ViewModel.RedoLabel, Mode=OneWay}" />
                    <AppBarSeparator />
                    <AppBarButton x:Uid="CommandAlign" IsEnabled="False">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8E4;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Uid="CommandExport"
                        Icon="Share"
                        IsEnabled="False" />
                </CommandBar>

                <!-- Paleta de comandos (Ctrl+K): las mismas órdenes que los menús, buscadas por su nombre. -->
                <AutoSuggestBox
                    x:Name="CommandSearch"
                    x:Uid="CommandSearch"
                    Grid.Column="2"
                    Width="240"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="CommandSearch"
                    QueryIcon="Find"
                    QuerySubmitted="OnCommandSearchSubmitted"
                    TextChanged="OnCommandSearchTextChanged"
                    UpdateTextOnSelect="False">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="shell:CommandEntry">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Shortcut}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>
        </Border>

        <!-- Fila 2: herramientas, lienzo y propiedades -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderThickness="0,0,1,0"
                Style="{StaticResource PaneBorderStyle}">
                <StackPanel
                    x:Name="ToolRail"
                    Padding="0,8"
                    Spacing="2">
                    <ToggleButton
                        x:Uid="ToolSelect"
                        AutomationProperties.AutomationId="ToolSelect"
                        Click="OnToolClick"
                        IsChecked="True"
                        Style="{StaticResource ToolButtonStyle}"
                        Tag="select">
                        <PathIcon Data="M3,2 L13,8.5 L8.6,9.6 L6.6,14 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolNode"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M1.5,11.5 L5,11.5 L5,15 L1.5,15 Z M11,1 L14.5,1 L14.5,4.5 L11,4.5 Z M3.6,11.5 C5,4.5 9.6,10.4 11.6,4.5 L12.6,4.9 C10.2,12 5.6,6.6 4.8,11.5 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolPen"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M8,1 L13,9 L8,15 L3,9 Z M8,7.3 A1.2,1.2 0 1 0 8,9.7 A1.2,1.2 0 1 0 8,7.3 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolRectangle"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M2,3 L14,3 L14,13 L2,13 Z M3.5,4.5 L3.5,11.5 L12.5,11.5 L12.5,4.5 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolEllipse"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M8,3 A6,5 0 1 0 8,13 A6,5 0 1 0 8,3 Z M8,4.5 A4.5,3.5 0 1 1 8,11.5 A4.5,3.5 0 1 1 8,4.5 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolText"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M3,2 L13,2 L13,5 L11.5,5 L11.5,3.5 L8.75,3.5 L8.75,12.5 L10.25,12.5 L10.25,14 L5.75,14 L5.75,12.5 L7.25,12.5 L7.25,3.5 L4.5,3.5 L4.5,5 L3,5 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolGradient"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M2,2 L14,2 L14,14 L2,14 Z M3.5,3.5 L3.5,12.5 L12.5,3.5 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolEyedropper"
                        AutomationProperties.AutomationId="ToolEyedropper"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}"
                        Tag="eyedropper">
                        <PathIcon Data="M11.5,1.5 A2,2 0 0 1 14.5,4.5 L12.6,6.4 L13.3,7.1 L12.2,8.2 L11.5,7.5 L5.5,13.5 L3,14 L2,13 L2.5,10.5 L8.5,4.5 L7.8,3.8 L8.9,2.7 L9.6,3.4 Z M9.6,5.6 L3.8,11.4 L3.6,12.4 L4.6,12.2 L10.4,6.4 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolHand"
                        AutomationProperties.AutomationId="ToolHand"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}"
                        Tag="hand">
                        <PathIcon Data="M5,6 L5,2.5 A1,1 0 0 1 7,2.5 L7,6 L7,1.5 A1,1 0 0 1 9,1.5 L9,6 L9,2.5 A1,1 0 0 1 11,2.5 L11,7 L11,5 A1,1 0 0 1 13,5 L13,10 C13,13 11,15 8.5,15 C6,15 5,14 3.5,12 L1.8,9.3 A1,1 0 0 1 3.4,8.2 L5,10 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolZoom"
                        AutomationProperties.AutomationId="ToolZoom"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}"
                        Tag="zoom">
                        <PathIcon Data="M6.5,1.5 A5,5 0 1 0 6.5,11.5 A5,5 0 1 0 6.5,1.5 Z M6.5,3 A3.5,3.5 0 1 1 6.5,10 A3.5,3.5 0 1 1 6.5,3 Z M10.4,11.4 L11.4,10.4 L15,14 L14,15 Z" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <controls:EngineCanvasView x:Name="EngineCanvas" Grid.Column="1" />

            <Border
                Grid.Column="2"
                BorderThickness="1,0,0,0"
                Style="{StaticResource PaneBorderStyle}">
                <StackPanel Padding="16,12" Spacing="8">
                    <TextBlock x:Uid="PropertiesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <!-- Con algo seleccionado: posición, tamaño y giro, en unidades del documento. -->
                    <StackPanel Spacing="8" Visibility="{x:Bind app:BindingFunctions.VisibleWhen(ViewModel.HasSelection), Mode=OneWay}">
                        <TextBlock x:Uid="GeometryTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <NumberBox
                                x:Uid="SelectionX"
                                AutomationProperties.AutomationId="SelectionX"
                                LargeChange="10"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Tag="X"
                                ValueChanged="OnGeometryValueChanged"
                                Value="{x:Bind ViewModel.SelectionX, Mode=OneWay}" />
                            <NumberBox
                                x:Uid="SelectionY"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="SelectionY"
                                LargeChange="10"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Tag="Y"
                                ValueChanged="OnGeometryValueChanged"
                                Value="{x:Bind ViewModel.SelectionY, Mode=OneWay}" />
                            <NumberBox
                                x:Uid="SelectionWidth"
                                Grid.Row="1"
                                AutomationProperties.AutomationId="SelectionWidth"
                                LargeChange="10"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Tag="Width"
                                ValueChanged="OnGeometryValueChanged"
                                Value="{x:Bind ViewModel.SelectionWidth, Mode=OneWay}" />
                            <NumberBox
                                x:Uid="SelectionHeight"
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="SelectionHeight"
                                LargeChange="10"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Tag="Height"
                                ValueChanged="OnGeometryValueChanged"
                                Value="{x:Bind ViewModel.SelectionHeight, Mode=OneWay}" />
                            <ToggleButton
                                x:Uid="LockAspectRatio"
                                Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="LockAspectRatio"
                                IsChecked="{x:Bind ViewModel.LockAspectRatio, Mode=TwoWay}">
                                <FontIcon FontSize="14" Glyph="&#xE72E;" />
                            </ToggleButton>
                            <NumberBox
                                x:Uid="SelectionRotation"
                                Grid.Row="2"
                                AutomationProperties.AutomationId="SelectionRotation"
                                IsEnabled="{x:Bind ViewModel.CanRotateSelection, Mode=OneWay}"
                                LargeChange="15"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Tag="Rotation"
                                ValueChanged="OnGeometryValueChanged"
                                Value="{x:Bind ViewModel.SelectionRotation, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            x:Uid="GeometryHint"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />

                        <!-- Apariencia: relleno, trazo y opacidad. -->
                        <TextBlock x:Uid="AppearanceTitle" Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Uid="FillLabel"
                                Grid.Row="0"
                                VerticalAlignment="Center" />
                            <DropDownButton
                                x:Name="FillButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="FillButton"
                                AutomationProperties.Name="{x:Bind PaintText(ViewModel.SelectionFill), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Width="16"
                                        Height="16"
                                        Background="{x:Bind app:BindingFunctions.PaintBrush(ViewModel.SelectionFill), Mode=OneWay}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                                    <TextBlock Text="{x:Bind PaintText(ViewModel.SelectionFill), Mode=OneWay}" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="FillFlyout" Closed="OnPaintFlyoutClosed" Opening="OnPaintFlyoutOpening">
                                        <StackPanel Width="300" Spacing="8">
                                            <ColorPicker
                                                x:Name="FillPicker"
                                                AutomationProperties.AutomationId="FillPicker"
                                                ColorChanged="OnPaintColorChanged"
                                                IsAlphaEnabled="False"
                                                IsColorPreviewVisible="False"
                                                IsHexInputVisible="True"
                                                IsMoreButtonVisible="False" />
                                            <Button
                                                x:Uid="FillNone"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="FillNone"
                                                Click="OnPaintNoneClick"
                                                Tag="fill" />
                                            <TextBlock x:Uid="RecentColorsLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <StackPanel x:Name="FillRecent" Orientation="Horizontal" Spacing="4" />
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <TextBlock
                                x:Uid="StrokeLabel"
                                Grid.Row="1"
                                VerticalAlignment="Center" />
                            <DropDownButton
                                x:Name="StrokeButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="StrokeButton"
                                AutomationProperties.Name="{x:Bind PaintText(ViewModel.SelectionStroke), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Width="16"
                                        Height="16"
                                        Background="{x:Bind app:BindingFunctions.PaintBrush(ViewModel.SelectionStroke), Mode=OneWay}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                                    <TextBlock Text="{x:Bind PaintText(ViewModel.SelectionStroke), Mode=OneWay}" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="StrokeFlyout" Closed="OnPaintFlyoutClosed" Opening="OnPaintFlyoutOpening">
                                        <StackPanel Width="300" Spacing="8">
                                            <ColorPicker
                                                x:Name="StrokePicker"
                                                AutomationProperties.AutomationId="StrokePicker"
                                                ColorChanged="OnPaintColorChanged"
                                                IsAlphaEnabled="False"
                                                IsColorPreviewVisible="False"
                                                IsHexInputVisible="True"
                                                IsMoreButtonVisible="False" />
                                            <Button
                                                x:Uid="StrokeNone"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="StrokeNone"
                                                Click="OnPaintNoneClick"
                                                Tag="stroke" />
                                            <TextBlock x:Uid="RecentColorsLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <StackPanel x:Name="StrokeRecent" Orientation="Horizontal" Spacing="4" />
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <NumberBox
                                x:Uid="SelectionStrokeWidth"
                                Grid.Row="2"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="SelectionStrokeWidth"
                                LargeChange="1"
                                Minimum="0"
                                SmallChange="0.5"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnStrokeWidthChanged"
                                Value="{x:Bind ViewModel.SelectionStrokeWidth, Mode=OneWay}" />
                            <NumberBox
                                x:Uid="SelectionOpacity"
                                Grid.Row="3"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="SelectionOpacity"
                                LargeChange="10"
                                Maximum="100"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnOpacityChanged"
                                Value="{x:Bind ViewModel.SelectionOpacityPercent, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!-- Sin nada seleccionado, el panel edita la mesa de trabajo. -->
                    <StackPanel Spacing="8" Visibility="{x:Bind app:BindingFunctions.VisibleUnless(ViewModel.HasSelection), Mode=OneWay}">
                        <TextBlock x:Uid="ArtboardTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="ArtboardWidthBox"
                                x:Uid="ArtboardWidth"
                                AutomationProperties.AutomationId="ArtboardWidth"
                                KeyDown="OnArtboardKeyDown"
                                LostFocus="OnArtboardLostFocus"
                                Text="{x:Bind app:BindingFunctions.ArtboardWidthText(ViewModel.CurrentArtboard), Mode=OneWay}" />
                            <TextBox
                                x:Name="ArtboardHeightBox"
                                x:Uid="ArtboardHeight"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="ArtboardHeight"
                                KeyDown="OnArtboardKeyDown"
                                LostFocus="OnArtboardLostFocus"
                                Text="{x:Bind app:BindingFunctions.ArtboardHeightText(ViewModel.CurrentArtboard), Mode=OneWay}" />
                        </Grid>
                        <TextBox
                            x:Name="ArtboardViewBoxBox"
                            x:Uid="ArtboardViewBox"
                            AutomationProperties.AutomationId="ArtboardViewBox"
                            KeyDown="OnArtboardKeyDown"
                            LostFocus="OnArtboardLostFocus"
                            Text="{x:Bind app:BindingFunctions.ArtboardViewBoxText(ViewModel.CurrentArtboard), Mode=OneWay}" />
                        <TextBlock
                            x:Uid="ArtboardHint"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fila 3: barra de estado -->
        <Border
            Grid.Row="3"
            BorderThickness="0,1,0,0"
            Style="{StaticResource PaneBorderStyle}">
            <Grid Padding="12,0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="EngineStatusTextBlock"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="EngineStatus"
                    AutomationProperties.HelpText="{x:Bind LatencyText(ViewModel.BridgeLatency), Mode=OneWay}"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{x:Bind EngineStatusText(ViewModel.EngineStatus), Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind EngineStatusText(ViewModel.EngineStatus), Mode=OneWay}" />
                <TextBlock
                    x:Name="ToolStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Name="SelectionStatusText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SelectionStatus"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
                <TextBlock
                    x:Name="LatencyStatusText"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind LatencyText(ViewModel.BridgeLatency), Mode=OneWay}"
                    Visibility="Collapsed" />
                <TextBlock
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ZoomStatus"
                    AutomationProperties.Name="{x:Bind ViewModel.ZoomText, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
