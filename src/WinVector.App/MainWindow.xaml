<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinVector.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinVector.App.Controls"
    xmlns:shell="using:WinVector.Core.Shell"
    Title="WinVector">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Distribución "Estudio clásico" (opción A del plan):
        fila 0, pestañas de documento en la barra de título;
        fila 1, menú y barra de comandos;
        fila 2, herramientas, lienzo y propiedades;
        fila 3, barra de estado.
    -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="ToolButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="PaneBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Fila 0: pestañas en la barra de título -->
        <TabView
            x:Name="DocumentTabs"
            Grid.Row="0"
            VerticalAlignment="Top"
            AddTabButtonClick="OnAddTabButtonClick"
            CanDragTabs="False"
            CanReorderTabs="False"
            IsAddTabButtonVisible="True"
            SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=OneWay}"
            SelectionChanged="OnDocumentTabsSelectionChanged"
            TabCloseRequested="OnTabCloseRequested"
            TabItemsSource="{x:Bind ViewModel.Documents}">
            <TabView.TabStripHeader>
                <StackPanel
                    x:Name="TitleBarHeader"
                    Padding="12,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Image
                        Width="16"
                        Height="16"
                        Source="ms-appx:///Assets/Square44x44Logo.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="WinVector" />
                </StackPanel>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="TitleBarDragRegion" Background="Transparent" />
            </TabView.TabStripFooter>
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="shell:DocumentTabViewModel">
                    <TabViewItem Header="{x:Bind Title, Mode=OneWay}">
                        <TabViewItem.IconSource>
                            <SymbolIconSource Symbol="Document" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Fila 1: menú y barra de comandos -->
        <Border
            Grid.Row="1"
            BorderThickness="0,1,0,1"
            Style="{StaticResource PaneBorderStyle}">
            <Grid Padding="4,0,8,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <MenuBar Grid.Column="0">
                    <MenuBarItem x:Uid="MenuFile">
                        <MenuFlyoutItem x:Uid="MenuFileNew" Command="{x:Bind ViewModel.NewDocumentCommand}">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="MenuFileOpen" IsEnabled="False">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuFileSave" IsEnabled="False">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="MenuFileSaveAs" IsEnabled="False">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuFileCloseTab" Click="OnCloseTabClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="W" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="MenuFileExit" Click="OnExitClick" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="MenuEdit">
                        <MenuFlyoutItem x:Uid="MenuEditUndo" IsEnabled="False">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Z" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="MenuEditRedo" IsEnabled="False">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Y" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuEditCut" IsEnabled="False" />
                        <MenuFlyoutItem x:Uid="MenuEditCopy" IsEnabled="False" />
                        <MenuFlyoutItem x:Uid="MenuEditPaste" IsEnabled="False" />
                        <MenuFlyoutItem x:Uid="MenuEditDelete" IsEnabled="False" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuEditSelectAll" IsEnabled="False" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="MenuObject">
                        <MenuFlyoutItem x:Uid="MenuObjectGroup" IsEnabled="False" />
                        <MenuFlyoutItem x:Uid="MenuObjectUngroup" IsEnabled="False" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuObjectBringToFront" IsEnabled="False" />
                        <MenuFlyoutItem x:Uid="MenuObjectSendToBack" IsEnabled="False" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="MenuPath">
                        <MenuFlyoutItem x:Uid="MenuPathObjectToPath" IsEnabled="False" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="MenuText">
                        <MenuFlyoutItem x:Uid="MenuTextFont" IsEnabled="False" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="MenuView">
                        <MenuFlyoutItem x:Uid="MenuViewZoomIn" IsEnabled="False" />
                        <MenuFlyoutItem x:Uid="MenuViewZoomOut" IsEnabled="False" />
                        <MenuFlyoutItem x:Uid="MenuViewFit" IsEnabled="False" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="MenuHelp">
                        <MenuFlyoutItem x:Uid="MenuHelpAbout" Click="OnAboutClick" />
                    </MenuBarItem>
                </MenuBar>

                <CommandBar
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    OverflowButtonVisibility="Auto">
                    <AppBarButton
                        x:Uid="CommandUndo"
                        Icon="Undo"
                        IsEnabled="False" />
                    <AppBarButton
                        x:Uid="CommandRedo"
                        Icon="Redo"
                        IsEnabled="False" />
                    <AppBarSeparator />
                    <AppBarButton x:Uid="CommandAlign" IsEnabled="False">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8E4;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Uid="CommandExport"
                        Icon="Share"
                        IsEnabled="False" />
                </CommandBar>

                <AutoSuggestBox
                    x:Uid="CommandSearch"
                    Grid.Column="2"
                    Width="240"
                    VerticalAlignment="Center"
                    IsEnabled="False"
                    QueryIcon="Find" />
            </Grid>
        </Border>

        <!-- Fila 2: herramientas, lienzo y propiedades -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderThickness="0,0,1,0"
                Style="{StaticResource PaneBorderStyle}">
                <StackPanel
                    x:Name="ToolRail"
                    Padding="0,8"
                    Spacing="2">
                    <ToggleButton
                        x:Uid="ToolSelect"
                        Click="OnToolClick"
                        IsChecked="True"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M3,2 L13,8.5 L8.6,9.6 L6.6,14 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolNode"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M1.5,11.5 L5,11.5 L5,15 L1.5,15 Z M11,1 L14.5,1 L14.5,4.5 L11,4.5 Z M3.6,11.5 C5,4.5 9.6,10.4 11.6,4.5 L12.6,4.9 C10.2,12 5.6,6.6 4.8,11.5 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolPen"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M8,1 L13,9 L8,15 L3,9 Z M8,7.3 A1.2,1.2 0 1 0 8,9.7 A1.2,1.2 0 1 0 8,7.3 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolRectangle"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M2,3 L14,3 L14,13 L2,13 Z M3.5,4.5 L3.5,11.5 L12.5,11.5 L12.5,4.5 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolEllipse"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M8,3 A6,5 0 1 0 8,13 A6,5 0 1 0 8,3 Z M8,4.5 A4.5,3.5 0 1 1 8,11.5 A4.5,3.5 0 1 1 8,4.5 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolText"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M3,2 L13,2 L13,5 L11.5,5 L11.5,3.5 L8.75,3.5 L8.75,12.5 L10.25,12.5 L10.25,14 L5.75,14 L5.75,12.5 L7.25,12.5 L7.25,3.5 L4.5,3.5 L4.5,5 L3,5 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolGradient"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M2,2 L14,2 L14,14 L2,14 Z M3.5,3.5 L3.5,12.5 L12.5,3.5 Z" />
                    </ToggleButton>
                    <ToggleButton
                        x:Uid="ToolZoom"
                        Click="OnToolClick"
                        Style="{StaticResource ToolButtonStyle}">
                        <PathIcon Data="M6.5,1.5 A5,5 0 1 0 6.5,11.5 A5,5 0 1 0 6.5,1.5 Z M6.5,3 A3.5,3.5 0 1 1 6.5,10 A3.5,3.5 0 1 1 6.5,3 Z M10.4,11.4 L11.4,10.4 L15,14 L14,15 Z" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <controls:EngineCanvasView x:Name="EngineCanvas" Grid.Column="1" />

            <Border
                Grid.Column="2"
                BorderThickness="1,0,0,0"
                Style="{StaticResource PaneBorderStyle}">
                <StackPanel Padding="16,12" Spacing="8">
                    <TextBlock x:Uid="PropertiesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Uid="PropertiesEmpty"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fila 3: barra de estado -->
        <Border
            Grid.Row="3"
            BorderThickness="0,1,0,0"
            Style="{StaticResource PaneBorderStyle}">
            <Grid Padding="12,0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Uid="StatusReady"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Name="ToolStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="100 %" />
            </Grid>
        </Border>
    </Grid>
</Window>
