<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinVector.App.Controls.EngineCanvasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Lienzo: un WebView2 que ejecuta el motor de edición. Es visible desde el principio, tapado por
        un panel opaco hasta que el motor termina de cargar (así no hay destellos en blanco). No se
        oculta con Opacity="0": si UI Automation consulta el control así, su contenido no vuelve a
        aparecer en el árbol de accesibilidad (#40).
    -->
    <Grid>
        <WebView2
            x:Name="CanvasWebView"
            AutomationProperties.AutomationId="EngineCanvas"
            IsHitTestVisible="False"
            IsTabStop="False" />

        <Grid x:Name="LoadingCover" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel
            x:Name="LoadingPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <ProgressRing
                Width="32"
                Height="32"
                IsActive="True" />
            <TextBlock
                x:Uid="CanvasLoading"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel
            x:Name="ErrorPanel"
            MaxWidth="440"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ErrorMessage"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <HyperlinkButton
                x:Name="RuntimeDownloadLink"
                x:Uid="CanvasRuntimeDownload"
                HorizontalAlignment="Center"
                NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/"
                Visibility="Collapsed" />
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
