<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinVector.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Medidas de la distribución "Estudio clásico" (opción A del plan). -->
            <x:Double x:Key="ToolRailWidth">48</x:Double>
            <x:Double x:Key="PropertiesPaneWidth">260</x:Double>
            <x:Double x:Key="StatusBarHeight">28</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
