{
  "name": "@winvector/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Motor de edición SVG de WinVector, ejecutado dentro del lienzo WebView2",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "perf": "playwright test --config playwright.perf.config.ts",
    "perf:compare": "node ../../tools/perf/compare.mjs perf/resultados/motor.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "contracts:generate": "node ../../contracts/tools/generate.mjs && prettier --write --log-level warn src/bridge/generated",
    "contracts:test": "node --test ../../contracts/tools/generate.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
