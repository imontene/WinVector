<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Herramienta de medición para el ADR 0004: compara un WebView2 por pestaña con un motor
    compartido por todas. Usa WinForms porque el control WebView2 de WinForms y el de WinUI
    comparten el mismo runtime y los mismos procesos, y así no hace falta empaquetar nada.
    No forma parte de la solución; se ejecuta desde el workflow "Medición de pestañas".
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WinVector.Tools.TabsBenchmark</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <!-- El motor compilado, igual que en la aplicación. -->
  <ItemGroup>
    <Content Include="..\..\src\engine\dist\**\*" Exclude="..\..\src\engine\dist\**\*.map">
      <Link>Engine\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
